config cmdenv-express-mode false
config cmdenv-redirect-output false
config cmdenv-stop-batch-on-error true
config record-eventlog false
config **.scalar-recording true
config **.vector-recording false
config extends warmUpTest
config warmup-period 10s
config repeat 35
config sim-time-limit 30s
config **.N 8
config **.K 50
config num-rngs 8*3
config network System
config sim-time-limit 20s
config cmdenv-express-mode false
config cmdenv-event-banners false
config repeat 35
config seed-set 17
config *.t[*].a 4B
config *.t[*].b 100B
config *.t[*].mean_T 0.002s
config *.t[*].rng-0 "ancestorIndex(0) * 3 + 0"
config *.t[*].rng-1 "ancestorIndex(0) * 3 + 1"
config *.t[*].rng-2 "ancestorIndex(0) * 3 + 2"
config output-vector-file "results/simulationTest/$N=8, $K=50-17.vec"
config output-scalar-file "results/simulationTest/$N=8, $K=50-17.sca"

