version 3
run simulationTest-912-20260212-12:23:17-21697
attr configname simulationTest
attr datetime 20260212-12:23:17
attr datetimef 20260212-122317
attr experiment simulationTest
attr inifile omnetpp.ini
attr iterationvars "$N=32, $K=50"
attr iterationvarsd N=32/K=50
attr iterationvarsf N=32,K=50-
attr measurement "$N=32, $K=50"
attr network System
attr processid 21697
attr repetition 2
attr replication #2
attr resultdir results
attr runnumber 912
attr seedset 2
itervar K 50
itervar N 32
config cmdenv-express-mode false
config cmdenv-redirect-output false
config cmdenv-stop-batch-on-error true
config record-eventlog false
config **.scalar-recording true
config **.vector-recording false
config extends warmUpTest
config warmup-period 10s
config **.N 32
config **.K 50
config num-rngs 32*3
config network System
config sim-time-limit 30s
config cmdenv-express-mode false
config cmdenv-event-banners false
config repeat 35
config seed-set 2
config *.t[*].a 4B
config *.t[*].b 100B
config *.t[*].mean_T 0.002s
config *.t[*].rng-0 "ancestorIndex(0) * 3 + 0"
config *.t[*].rng-1 "ancestorIndex(0) * 3 + 1"
config *.t[*].rng-2 "ancestorIndex(0) * 3 + 2"
config output-vector-file "results/simulationTest/$N=32, $K=50-2.vec"
config output-scalar-file "results/simulationTest/$N=32, $K=50-2.sca"

vector 0 System.oracle throughputStat:vector ETV
attr "" ""
