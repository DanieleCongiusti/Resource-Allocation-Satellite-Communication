attr experiment simulationTest
attr inifile omnetpp.ini
attr iterationvars "$N=32, $K=1000"
attr iterationvarsd N=32/K=1000
attr iterationvarsf N=32,K=1000-
attr measurement "$N=32, $K=1000"
