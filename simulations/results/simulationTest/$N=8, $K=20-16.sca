config *.t[*].a 4B
config *.t[*].b 100B
config *.t[*].mean_T 0.002s
config *.t[*].rng-0 "ancestorIndex(0) * 3 + 0"
config *.t[*].rng-1 "ancestorIndex(0) * 3 + 1"
