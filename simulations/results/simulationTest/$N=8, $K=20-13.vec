version 3
run simulationTest-153-20260212-12:15:01-20767
attr configname simulationTest
attr datetime 20260212-12:15:01
attr datetimef 20260212-121501
attr experiment simulationTest
attr inifile omnetpp.ini
attr iterationvars "$N=8, $K=20"
attr iterationvarsd N=8/K=20
attr iterationvarsf N=8,K=20-
attr measurement "$N=8, $K=20"
attr network System
attr processid 20767
attr repetition 13
attr replication #13
attr resultdir results
attr runnumber 153
attr seedset 13
itervar K 20
itervar N 8
config cmdenv-express-mode false
config cmdenv-redirect-output false
config cmdenv-stop-batch-on-error true
config record-eventlog false
config **.scalar-recording true
config **.vector-recording false
config extends warmUpTest
