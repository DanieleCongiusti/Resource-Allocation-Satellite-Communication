version 3
run simulationTest-223-20260212-12:15:30-20845
attr configname simulationTest
attr datetime 20260212-12:15:30
attr datetimef 20260212-121530
attr experiment simulationTest
attr inifile omnetpp.ini
attr iterationvars "$N=8, $K=1000"
attr iterationvarsd N=8/K=1000
attr iterationvarsf N=8,K=1000-
attr measurement "$N=8, $K=1000"
attr network System
attr processid 20845
attr repetition 13
attr replication #13
attr resultdir results
attr runnumber 223
attr seedset 13
itervar K 1000
itervar N 8
config cmdenv-express-mode false
config cmdenv-redirect-output false
config cmdenv-stop-batch-on-error true
config record-eventlog false
config **.scalar-recording true
config **.vector-recording false
config extends warmUpTest
config warmup-period 10s
config **.N 8
config **.K 1000
config num-rngs 8*3
config network System
config sim-time-limit 30s
config cmdenv-express-mode false
config cmdenv-event-banners false
config repeat 35
config seed-set 13
config *.t[*].a 4B
config *.t[*].b 100B
config *.t[*].mean_T 0.002s
config *.t[*].rng-0 "ancestorIndex(0) * 3 + 0"
config *.t[*].rng-1 "ancestorIndex(0) * 3 + 1"
config *.t[*].rng-2 "ancestorIndex(0) * 3 + 2"
config output-vector-file "results/simulationTest/$N=8, $K=1000-13.vec"
config output-scalar-file "results/simulationTest/$N=8, $K=1000-13.sca"

vector 0 System.oracle throughputStat:vector ETV
attr "" ""
attr recordingmode vector
attr source throughput
vector 1 System.oracle AvgQLStat:vector ETV
attr "" ""
attr recordingmode vector
attr source avgQueueLength

