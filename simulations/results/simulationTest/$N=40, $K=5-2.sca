version 3
run simulationTest-1052-20260212-12:25:24-21890
attr configname simulationTest
attr datetime 20260212-12:25:24
attr datetimef 20260212-122524
attr experiment simulationTest
attr inifile omnetpp.ini
attr iterationvars "$N=40, $K=5"
attr iterationvarsd N=40/K=5
attr iterationvarsf N=40,K=5-
attr measurement "$N=40, $K=5"
attr network System
attr processid 21890
attr repetition 2
attr replication #2
attr resultdir results
attr runnumber 1052
attr seedset 2
itervar K 5
itervar N 40
config cmdenv-express-mode false
config cmdenv-redirect-output false
config cmdenv-stop-batch-on-error true
config record-eventlog false
config **.scalar-recording true
config **.vector-recording false
config extends warmUpTest
config warmup-period 10s
config **.N 40
config **.K 5
config num-rngs 40*3
config network System
config sim-time-limit 30s
config cmdenv-express-mode false
config cmdenv-event-banners false
config repeat 35
config seed-set 2
config *.t[*].a 4B
config *.t[*].b 100B
config *.t[*].mean_T 0.002s
config *.t[*].rng-0 "ancestorIndex(0) * 3 + 0"
config *.t[*].rng-1 "ancestorIndex(0) * 3 + 1"
config *.t[*].rng-2 "ancestorIndex(0) * 3 + 2"
config output-vector-file "results/simulationTest/$N=40, $K=5-2.vec"
config output-scalar-file "results/simulationTest/$N=40, $K=5-2.sca"

