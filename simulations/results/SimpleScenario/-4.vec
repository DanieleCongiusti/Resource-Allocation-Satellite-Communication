version 3
run SimpleScenario-4-20260211-10:15:10-2972
attr configname SimpleScenario
attr datetime 20260211-10:15:10
attr datetimef 20260211-101510
attr experiment SimpleScenario
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network System
attr processid 2972
attr repetition 4
attr replication #4
attr resultdir results
attr runnumber 4
attr seedset 4
config cmdenv-express-mode false
config cmdenv-redirect-output false
config cmdenv-stop-batch-on-error true
config record-eventlog false
config **.scalar-recording true
config **.vector-recording false
config sim-time-limit 5s
config **.N 2
config **.K 100
config num-rngs 2*3
config network System
config sim-time-limit 20s
config cmdenv-express-mode false
config cmdenv-event-banners false
config repeat 35
config seed-set 4
config *.t[*].a 4B
config *.t[*].b 100B
config *.t[*].mean_T 0.002s
config *.t[*].rng-0 "ancestorIndex(0) * 3 + 0"
config *.t[*].rng-1 "ancestorIndex(0) * 3 + 1"
config *.t[*].rng-2 "ancestorIndex(0) * 3 + 2"
config output-vector-file results/SimpleScenario/-4.vec
config output-scalar-file results/SimpleScenario/-4.sca

vector 0 System.oracle throughputWarmUpStat:vector ETV
